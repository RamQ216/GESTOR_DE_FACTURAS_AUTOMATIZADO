# Configuración de Google Gemini API (obtener en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-3.6-flash

# ID del documento de Google Sheets (la cadena larga en la URL de tu hoja)
# Ejemplo: https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEETS_DOCUMENT_ID=tu_google_sheets_document_id_aqui

# Configuración local de n8n
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
N8N_ENCRYPTION_KEY=cambia_esta_clave_secreta_de_32_caracteres
